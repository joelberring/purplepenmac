<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end print-production tests: load a real event and OCAD map, create course PDFs
    through Controller/CoursePdf exactly like the application, and inspect the PDF content
    stream (colour order, overprint and blend mode). Runs headless on macOS, Linux and Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Brings the Linux native Skia/HarfBuzz libraries (as in the Avalonia app); macOS/Windows natives come with SkiaSharp. -->
    <PackageReference Include="Avalonia.Skia" VersionOverride="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PurplePenCore\PurplePenCore.csproj" />
    <ProjectReference Include="..\MapModel\Map_PDF\Map_PDF.csproj" />
    <ProjectReference Include="..\MapModel\Map_SkiaStd\Map_SkiaStd.csproj" />
    <ProjectReference Include="..\MapModel\PDFsharp\src\foundation\src\PDFsharp\src\PdfSharp\PdfSharp.csproj" />
  </ItemGroup>

</Project>
