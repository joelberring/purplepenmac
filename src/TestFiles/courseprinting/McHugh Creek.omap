The symbol shall be combined with other symbols to show runnability and openness.
The symbol is orientated to north.
Minimum area: 2.0 mm x 0.7 mm (footprint 30 m x 10.5 m).</description><point_symbol inner_radius="1500" inner_color="-1" outer_width="0" outer_color="-1" elements="4"><element><symbol type="2" code=""><line_symbol color="5" line_width="150" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="6000" break_length="1500" dashes_in_group="1" in_group_break_length="750" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">-675 -450;675 -450;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element><element><symbol type="2" code=""><line_symbol color="5" line_width="150" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="6000" break_length="1500" dashes_in_group="1" in_group_break_length="750" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">-675 450;675 450;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element><element><symbol type="2" code=""><line_symbol color="5" line_width="150" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="6000" break_length="1500" dashes_in_group="1" in_group_break_length="750" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">-1537 0;-187 0;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element><element><symbol type="2" code=""><line_symbol color="5" line_width="150" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="6000" break_length="1500" dashes_in_group="1" in_group_break_length="750" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">188 0;1537 0;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element></point_symbol></symbol>
<symbol type="1" id="72" code="311" name="Well, fountain or water tank"><description>A prominent well, fountain, water tank or captive spring.
Footprint: 12 m x 12 m.</description><point_symbol inner_radius="1500" inner_color="-1" outer_width="0" outer_color="-1" elements="1"><element><symbol type="2" code=""><line_symbol color="5" line_width="270" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="6000" break_length="1500" dashes_in_group="1" in_group_break_length="750" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="5">-465 -465;465 -465 32;465 465 32;-465 465 32;-465 -465 18;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element></point_symbol></symbol>
<symbol type="1" id="73" code="312" name="Spring"><description>A source of water.
Location is the centre of gravity of the symbol.
The symbol is orientated to open downstream.
Footprint: 13.5 m x 7 m.</description><point_symbol rotatable="true" inner_radius="1500" inner_color="-1" outer_width="0" outer_color="-1" elements="1"><element><symbol type="2" code=""><line_symbol color="5" line_width="270" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="6000" break_length="1500" dashes_in_group="1" in_group_break_length="750" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="7">540 -351 1;540 -54;299 189;0 189 1;-298 189;-540 -54;-540 -351;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element></point_symbol></symbol>
<symbol type="1" id="74" code="313" name="Prominent water feature"><description>The symbol is orientated to north.
The definition of the symbol must be given on the map.
Footprint: 13.5 m x 13.5 m.</description><point_symbol inner_radius="1572" inner_color="-1" outer_width="0" outer_color="-1" elements="5"><element><symbol type="2" code=""><line_symbol color="5" line_width="240" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6284" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="6284" break_length="1572" dashes_in_group="1" in_group_break_length="786" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">0 -675;0 0;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element><element><symbol type="2" code=""><line_symbol color="5" line_width="240" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6284" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="6284" break_length="1572" dashes_in_group="1" in_group_break_length="786" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">642 -209;0 0;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element><element><symbol type="2" code=""><line_symbol color="5" line_width="240" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6284" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="6284" break_length="1572" dashes_in_group="1" in_group_break_length="786" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">398 546;0 0;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element><element><symbol type="2" code=""><line_symbol color="5" line_width="240" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_le