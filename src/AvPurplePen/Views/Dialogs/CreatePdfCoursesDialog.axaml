<!--
    CreatePdfCoursesDialog.axaml

    Dialog for exporting courses as PDF files. Layout is similar to the
    CreateOcadFiles / CreateImageFiles dialogs: CourseSelector on the left,
    an Appearance group (page handling, include base map, color model,
    optional merge-parts checkbox), a Files group (file format combo +
    filename prefix), and a Folder group (3 radio buttons + folder picker),
    Create/Cancel buttons at the bottom.

    Migrated from WinForms PurplePen/CreatePdfCourses.cs.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:views="using:AvPurplePen.Views"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AvPurplePen.Views.CreatePdfCoursesDialog"
        Classes="dialog"
        x:DataType="vm:CreatePdfCoursesDialogViewModel"
        Title="{resx:Localize CreatePdfCourses_Text}"
        Icon="/Assets/transparent.ico"
        d:DesignWidth="920" d:DesignHeight="700"
        Width="920" Height="700"
        MinWidth="760" MinHeight="560"
        CanResize="True"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:CreatePdfCoursesDialogViewModel/>
    </Design.DataContext>

    <DockPanel Margin="12">

        <!-- Create / Cancel buttons at the bottom -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button x:Name="okButton"
                    Content="{resx:Localize CreatePdfCourses_okButton_Text}"
                    Width="100"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button x:Name="cancelButton"
                    Content="{resx:Localize CancelButton}"
                    Width="100"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Two columns. Left = courses, right = appearance + files + folder. -->
        <Grid ColumnDefinitions="300,12,*">

            <!-- === Left column: Courses group === -->
            <HeaderedContentControl Grid.Column="0"
                                    Header="{resx:Localize CreatePdfCourses_coursesGroupBox_Text}"
                                    Padding="8,10,8,8">
                <views:CourseSelector x:Name="courseSelector"
                                      EventDB="{Binding EventDB}"
                                      ShowAllControls="True"
                                      ShowCourseParts="False"
                                      ShowVariationChooser="True"/>
            </HeaderedContentControl>

            <!-- === Right column: Appearance, Files, Folder === -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>

                <!-- Appearance group -->
                <HeaderedContentControl DockPanel.Dock="Top"
                                        Header="{resx:Localize CreatePdfCourses_groupBoxAppearance_Text}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                        <!-- "If the print area is too large to fit on one page:" -->
                        <TextBlock Text="{resx:Localize CreatePdfCourses_labelAppearanceInfo_Text}"
                                   TextWrapping="Wrap"/>
                        <ComboBox x:Name="comboBoxMultiPage"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding EnableChangeCropping}"
                                  SelectedIndex="{Binding MultiPageIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxMultiPage_Items}"/>
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxMultiPage_Items1}"/>
                        </ComboBox>

                        <TextBlock Text="{resx:Localize CreatePdfCourses_labelTrainingProfile_Text}"
                                   Margin="0,4,0,0"/>
                        <ComboBox x:Name="comboBoxTrainingProfile"
                                  SelectedIndex="{Binding TrainingExerciseRenderProfileIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_trainingProfile_None}"/>
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_trainingProfile_Runner}"/>
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_trainingProfile_Coach}"/>
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_trainingProfile_Answer}"/>
                        </ComboBox>
                        <TextBlock Text="{resx:Localize CreatePdfCourses_trainingProfile_VectorWarning}"
                                   TextWrapping="Wrap" FontSize="11" Opacity="0.75"/>

                        <TextBlock Text="{resx:Localize CreatePdfCourses_labelPageLayout_Text}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <ComboBox x:Name="comboBoxPageLayout"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="{Binding PageLayoutIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxPageLayout_Items}"/>
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxPageLayout_Items1}"/>
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxPageLayout_Items2}"/>
                        </ComboBox>

                        <TextBlock Text="{resx:Localize CreatePdfCourses_calibrationTitle_Text}"
                                   Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="Auto,90,Auto,Auto" ColumnSpacing="6">
                            <TextBlock VerticalAlignment="Center" Text="{resx:Localize CreatePdfCourses_calibrationMeasured_Text}"/>
                            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="1000" Increment="0.1"
                                           FormatString="0.##" Value="{Binding MeasuredCalibrationMm, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="mm"/>
                            <Button Grid.Column="3" Content="{resx:Localize CreatePdfCourses_calibrationApply_Text}"
                                    Command="{Binding ApplyCalibrationCommand}" Classes="Small"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{resx:Localize CreatePdfCourses_calibrationFactor_Text}"/>
                            <TextBlock Text="{Binding ScaleCalibrationFactor, StringFormat=0.0000}"/>
                            <Button Content="{resx:Localize CreatePdfCourses_calibrationReset_Text}"
                                    Command="{Binding ResetCalibrationCommand}" Classes="Small"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,4,0,0">
                            <ComboBox ItemsSource="{Binding PrintTemplates}"
                                      SelectedItem="{Binding SelectedPrintTemplate, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding Name}"/>
                            <Button Grid.Column="1" Content="{resx:Localize CreatePdfCourses_templateApply_Text}"
                                    Command="{Binding ApplyPrintTemplateCommand}" Classes="Small"/>
                            <Button Grid.Column="2" Content="{resx:Localize CreatePdfCourses_templateDelete_Text}"
                                    Command="{Binding DeletePrintTemplateCommand}" Classes="Small"/>
                            <Button Grid.Column="3" Content="{resx:Localize CreatePdfCourses_templateSave_Text}"
                                    Command="{Binding SavePrintTemplateCommand}" Classes="Small"/>
                        </Grid>
                        <TextBox PlaceholderText="{resx:Localize CreatePdfCourses_templateName_Text}"
                                 Text="{Binding PrintTemplateName, Mode=TwoWay}"/>

                        <Expander Header="{resx:Localize CreatePdfCourses_workshopPreview_Text}"
                                  IsExpanded="True" Margin="0,6,0,0">
                            <ScrollViewer MaxHeight="190" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding WorkshopPreview}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PrintWorkshopPreviewItem">
                                            <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                                    BorderThickness="0,0,0,1" Padding="3,2">
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,*" ColumnSpacing="6">
                                                    <TextBlock Text="{resx:Localize CreatePdfCourses_previewSheet_Text}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SheetNumber}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{resx:Localize CreatePdfCourses_previewFront_Text}"
                                                               IsVisible="{Binding IsFront}"/>
                                                    <TextBlock Grid.Column="2" Text="{resx:Localize CreatePdfCourses_previewBack_Text}"
                                                               IsVisible="{Binding IsBack}"/>
                                                    <TextBlock Grid.Column="3" Text="{resx:Localize CreatePdfCourses_previewSlots_Text}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding SlotSummary}"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>

                        <!-- Include (base map or just course) / Color model. -->
                        <Grid ColumnDefinitions="Auto,8,*"
                              RowDefinitions="Auto,4,Auto,4,Auto,4,Auto,Auto"
                              Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{resx:Localize CreatePdfCourses_labelPrintBaseMap_Text}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="comboBoxPrintBaseMap"
                                      Grid.Row="0" Grid.Column="2"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding PrintBaseMapIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxPrintBaseMap_Items}"/>
                                <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxPrintBaseMap_Items1}"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="{resx:Localize CreatePdfCourses_labelColorModel_Text}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="comboBoxColorModel"
                                      Grid.Row="2" Grid.Column="2"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding ColorModelIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxColorModel_Items}"/>
                                <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxColorModel_Items1}"/>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="{resx:Localize CreatePdfCourses_labelPrintProfile_Text}"
                                       VerticalAlignment="Center"/>
                            <Grid Grid.Row="4" Grid.Column="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                <ComboBox x:Name="comboBoxPrintProfile"
                                          SelectedIndex="{Binding PrintProfileIndex, Mode=TwoWay}"
                                          ItemsSource="{Binding PrintProfiles}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PrintProfileChoice">
                                            <StackPanel>
                                                <TextBlock IsVisible="{Binding IsNone}" Text="{resx:Localize CreatePdfCourses_comboBoxPrintProfile_None}"/>
                                                <TextBlock IsVisible="{Binding IsProfile}" Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Classes="Small" Content="{resx:Localize CreatePdfCourses_importPrintProfile_Text}"
                                        Click="ImportPrintProfileButton_Click"/>
                                <Button Grid.Column="2" Classes="Small" Content="{resx:Localize CreatePdfCourses_exportPrintProfile_Text}"
                                        Click="ExportPrintProfileButton_Click"/>
                                <Button Grid.Column="3" Classes="Small" Content="{resx:Localize CreatePdfCourses_editPrintProfile_Text}"
                                        Click="EditPrintProfileButton_Click"/>
                            </Grid>
                            <TextBlock Grid.Row="6" Grid.ColumnSpan="3"
                                       Text="{resx:Localize CreatePdfCourses_printProfileHelp_Text}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Text="{Binding PrintProfileMessage}"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Expander Header="{resx:Localize CreatePdfCourses_printProfilePreview_Text}"
                                  IsVisible="{Binding HasSelectedPrintProfile}"
                                  Margin="0,4,0,0">
                            <StackPanel Spacing="4" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{resx:Localize CreatePdfCourses_printProfileMapKind_Text}"/>
                                    <TextBlock IsVisible="{Binding SelectedPrintProfileIsForest}"
                                               Text="{resx:Localize CreatePdfCourses_printProfileMapKindForest_Text}"/>
                                    <TextBlock IsVisible="{Binding SelectedPrintProfileIsSprint}"
                                               Text="{resx:Localize CreatePdfCourses_printProfileMapKindSprint_Text}"/>
                                    <TextBlock Text="·"/>
                                    <TextBlock Text="{resx:Localize CreatePdfCourses_printProfileVersion_Text}"/>
                                    <TextBlock Text="{Binding SelectedPrintProfileVersionDate}"/>
                                </StackPanel>
                                <ScrollViewer MaxHeight="130" HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedPrintProfileRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PrintProfileRulePreview">
                                                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="6" Margin="0,2">
                                                    <Border Width="20" Height="20" Background="{Binding PreviewColor}"
                                                            BorderBrush="Black" BorderThickness="1" CornerRadius="2"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Cmyk}" FontSize="11" Opacity="0.8"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock IsVisible="{Binding UsesOverprint}" Text="{resx:Localize PrintProfileMappingsDialog_overprint_Text}" FontSize="11"/>
                                                        <TextBlock IsVisible="{Binding UsesKnockout}"
                                                                   Text="{resx:Localize PrintProfileMappingsDialog_knockout_Text}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Expander>

                        <!-- "Print Map Exchanges on Same Map" — only shown when
                             the event has at least one multi-part course. -->
                        <CheckBox x:Name="checkBoxMergeParts"
                                  Content="{resx:Localize CreatePdfCourses_checkBoxMergeParts_Text}"
                                  IsChecked="{Binding MergeParts, Mode=TwoWay}"
                                  IsVisible="{Binding ShowMergeParts}"
                                  Margin="0,4,0,0"/>

                        <CheckBox x:Name="checkBoxBacksideInfo"
                                  Content="{resx:Localize CreatePdfCourses_checkBoxBacksideInfo_Text}"
                                  IsChecked="{Binding IncludeBacksideInfo, Mode=TwoWay}"
                                  Margin="0,4,0,0"/>
                        <TextBox x:Name="backsideTextBox"
                                 Text="{Binding BacksideText, Mode=TwoWay}"
                                 IsEnabled="{Binding IncludeBacksideInfo}"
                                 PlaceholderText="{resx:Localize CreatePdfCourses_backsideTextWatermark_Text}"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    IsEnabled="{Binding IncludeBacksideInfo}">
                            <Button x:Name="importBacksideInfoButton"
                                    Classes="Small"
                                    Content="{resx:Localize CreatePdfCourses_importBacksideInfoButton_Text}"
                                    Click="ImportBacksideInfoButton_Click"/>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{resx:Localize CreatePdfCourses_backsideImportStatus_Text}"/>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding ImportedBacksideInfoCount}"/>
                        </StackPanel>
                        <TextBlock Text="{resx:Localize CreatePdfCourses_backsideImportHelp_Text}"
                                   IsEnabled="{Binding IncludeBacksideInfo}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BacksideInfoImportError}"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Files group (docked at top, content-height only) -->
                <HeaderedContentControl DockPanel.Dock="Top"
                                        Header="{resx:Localize CreatePdfCourses_outputGroupBox_Text}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,8,*"
                          RowDefinitions="Auto,4,Auto,4,Auto">

                        <!-- "Files:" -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{resx:Localize CreatePdfCourses_filesLabel_Text}"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="comboBoxFileFormat"
                                  Grid.Row="0" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="{Binding FileFormatIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxFileFormat_Items}"/>
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxFileFormat_Items1}"/>
                            <ComboBoxItem Content="{resx:Localize CreatePdfCourses_comboBoxFileFormat_Items2}"/>
                        </ComboBox>

                        <!-- "File name prefix:" -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{resx:Localize CreatePdfCourses_fileNamePrefixLabel_Text}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="filenamePrefixTextBox"
                                 Grid.Row="2" Grid.Column="2"
                                 Text="{Binding FilePrefix, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="{resx:Localize CreatePdfCourses_copiesLabel_Text}"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="copiesUpDown"
                                       Grid.Row="4" Grid.Column="2"
                                       Width="90"
                                       HorizontalAlignment="Left"
                                       Minimum="1"
                                       Maximum="9999"
                                       FormatString="0"
                                       Value="{Binding Copies, Mode=TwoWay}"/>
                    </Grid>
                </HeaderedContentControl>

                <!-- Folder group (last child — fills the remaining vertical
                     space in this DockPanel, since DockPanel.LastChildFill
                     is true by default). -->
                <HeaderedContentControl Header="{resx:Localize CreatePdfCourses_folderGroupBox_Text}"
                                        Padding="8">
                    <StackPanel Spacing="4">
                        <RadioButton x:Name="coursesDirectory"
                                     GroupName="OutputFolder"
                                     Content="{resx:Localize CreatePdfCourses_coursesDirectory_Text}"
                                     IsChecked="{Binding UseFileDirectory, Mode=TwoWay}"/>
                        <RadioButton x:Name="mapDirectory"
                                     GroupName="OutputFolder"
                                     Content="{resx:Localize CreatePdfCourses_mapDirectory_Text}"
                                     IsChecked="{Binding UseMapDirectory, Mode=TwoWay}"/>
                        <RadioButton x:Name="otherDirectory"
                                     GroupName="OutputFolder"
                                     Content="{resx:Localize CreatePdfCourses_otherDirectory_Text}"
                                     IsChecked="{Binding UseOtherDirectory, Mode=TwoWay}"/>

                        <!-- Other folder text box + Select folder button.
                             Only visible when the "Other folder" radio is selected. -->
                        <TextBox x:Name="otherDirectoryTextBox"
                                 Text="{Binding OutputDirectory, Mode=TwoWay}"
                                 IsVisible="{Binding IsOtherDirectoryVisible}"
                                 Margin="20,4,0,0"/>
                        <Button x:Name="selectOtherDirectoryButton"
                                Classes="Small"
                                Content="{resx:Localize CreatePdfCourses_selectOtherDirectoryButton_Text}"
                                IsVisible="{Binding IsOtherDirectoryVisible}"
                                HorizontalAlignment="Right"
                                Click="SelectOtherDirectoryButton_Click"/>
                    </StackPanel>
                </HeaderedContentControl>
              </StackPanel>
            </ScrollViewer>

        </Grid>

    </DockPanel>
</Window>
