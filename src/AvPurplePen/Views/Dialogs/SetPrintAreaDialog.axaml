<!--
    SetPrintAreaDialog.axaml

    Interactive tool window for choosing a course's printing area. The user drags
    a rectangle on the map (which stays interactive — this is an owned, non-modal
    window) while this dialog offers paper size, an "automatic" toggle, and a
    "fix size to paper" toggle. The ViewModel mirrors every change into the
    Controller's rectangle-select mode so the live preview tracks the dialog.

    Reuses the shared PaperSizeControl. Migrated from WinForms
    PurplePen/SetPrintAreaDialog.cs.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:views="using:AvPurplePen.Views"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AvPurplePen.Views.SetPrintAreaDialog"
        Classes="dialog"
        x:DataType="vm:SetPrintAreaDialogViewModel"
        Title="{resx:Localize SetPrintAreaDialog_Text}"
        Icon="/Assets/transparent.ico"
        d:DesignWidth="410" d:DesignHeight="650"
        Width="410" Height="650" MinHeight="520"
        CanResize="True"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:SetPrintAreaDialogViewModel/>
    </Design.DataContext>

    <DockPanel Margin="12">

        <!-- Done / Cancel buttons at the bottom right. -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button x:Name="cancelButton"
                    Content="{resx:Localize SetPrintAreaDialog_cancelButton_Text}"
                    Width="82"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="okButton"
                    Content="{resx:Localize SetPrintAreaDialog_okButton_Text}"
                    Width="82"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    Click="OkButton_Click"/>
        </StackPanel>

        <StackPanel Spacing="10">

            <!-- Paper size group: hosts the shared PaperSizeControl. -->
            <HeaderedContentControl Header="{resx:Localize SetPrintAreaDialog_groupBoxPaperSize_Text}"
                                    Padding="8,8,8,8">
                <views:PaperSizeControl x:Name="paperSizeControl"
                                        HorizontalAlignment="Left"
                                        SeparateMargins="False"
                                        PaperWidth="{Binding PaperWidth, Mode=TwoWay}"
                                        PaperHeight="{Binding PaperHeight, Mode=TwoWay}"
                                        PaperMargin="{Binding PaperMargin, Mode=TwoWay}"
                                        Landscape="{Binding Landscape, Mode=TwoWay}"/>
            </HeaderedContentControl>

            <HeaderedContentControl Header="{resx:Localize SetPrintAreaDialog_templates_Text}" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{resx:Localize SetPrintAreaDialog_templatesHelp_Text}" TextWrapping="Wrap" Opacity="0.75"/>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Name}"/>
                        <Button Grid.Column="1" Content="{resx:Localize SetPrintAreaDialog_applyTemplate_Text}"
                                Command="{Binding ApplyTemplateCommand}" Classes="Small"/>
                        <Button Grid.Column="2" Content="{resx:Localize SetPrintAreaDialog_deleteTemplate_Text}"
                                Command="{Binding DeleteTemplateCommand}" Classes="Small"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox PlaceholderText="{resx:Localize SetPrintAreaDialog_templateName_Text}"
                                 Text="{Binding TemplateName, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="{resx:Localize SetPrintAreaDialog_saveTemplate_Text}"
                                Command="{Binding SaveTemplateCommand}" Classes="Small"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <CheckBox x:Name="checkBoxAutomatic"
                      Content="{resx:Localize SetPrintAreaDialog_checkBoxAutomatic_Text}"
                      IsChecked="{Binding Automatic, Mode=TwoWay}"/>
            <TextBlock Text="{resx:Localize SetPrintAreaDialog_automaticHelp_Text}" TextWrapping="Wrap" Opacity="0.75" Margin="22,-8,0,0"/>

            <CheckBox x:Name="checkBoxFixSizeToPaper"
                      Content="{resx:Localize SetPrintAreaDialog_checkBoxFixSizeToPaper_Text}"
                      IsChecked="{Binding FixSizeToPaper, Mode=TwoWay}"/>
            <TextBlock Text="{resx:Localize SetPrintAreaDialog_fixSizeHelp_Text}" TextWrapping="Wrap" Opacity="0.75" Margin="22,-8,0,0"/>

            <Grid ColumnDefinitions="Auto,110,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" Text="{resx:Localize SetPrintAreaDialog_rotation_Text}"/>
                <NumericUpDown Grid.Column="1" Minimum="-180" Maximum="180" Increment="1"
                               FormatString="0.##°"
                               Value="{Binding RotationDegrees, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{resx:Localize SetPrintAreaDialog_rotationHelp_Text}"/>
            </Grid>

            <Border BorderBrush="#777777" BorderThickness="1" Background="#F4F4F4"
                    Width="280" Height="150" HorizontalAlignment="Center" Padding="12">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="170" Height="104" BorderBrush="#333333" BorderThickness="2"
                            Background="#FFFFFF" RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                            <RotateTransform Angle="{Binding RotationDegrees}"/>
                        </Border.RenderTransform>
                        <Border Width="138" Height="72" BorderBrush="#7A4A9B" BorderThickness="2"
                                Background="#EEE6F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasLowMarginWarning}"
                    Background="#FFF4CE"
                    BorderBrush="#C88A00"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,6">
                <TextBlock x:Name="lowMarginWarning"
                           Text="{resx:Localize SetPrintAreaDialog_lowMarginWarning_Text}"
                           TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="setPrintAreaLabel"
                       TextWrapping="Wrap"
                       Text="{resx:Localize SetPrintAreaDialog_setPrintAreaLabel_Text}"/>

        </StackPanel>

    </DockPanel>
</Window>
