<!-- Route-choice measurements for the active course. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        x:Class="AvPurplePen.Views.RouteChoiceAnalysisDialog"
        x:DataType="vm:RouteChoiceAnalysisDialogViewModel"
        Title="{resx:Localize RouteChoiceAnalysisDialog_Title}"
        Width="820" Height="500" MinWidth="600" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Design.DataContext><vm:RouteChoiceAnalysisDialogViewModel/></Design.DataContext>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock FontSize="18" FontWeight="Bold" Text="{resx:Localize RouteChoiceAnalysisDialog_Title}"/>
            <TextBlock Text="{Binding CourseName}"/>
            <TextBlock Margin="0,6,0,0" Text="{resx:Localize RouteChoiceAnalysisDialog_Explanation}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">
            <Button Grid.Column="0" Margin="0,0,8,0" Content="{resx:Localize RouteChoiceAnalysisDialog_DrawCandidate}" Command="{Binding StartCandidateCommand}"/>
            <Button Grid.Column="1" Margin="0,0,8,0" Content="{resx:Localize RouteChoiceAnalysisDialog_DeleteCandidate}" Command="{Binding DeleteCandidateCommand}"/>
            <Button Grid.Column="3" Width="100" IsDefault="True" IsCancel="True"
                    Content="{resx:Localize ReportForm_okButton_Text}" Click="Close_Click"/>
        </Grid>
        <Border BorderBrush="{DynamicResource SemiGrey2}" BorderThickness="1">
          <Grid RowDefinitions="*,180">
            <DataGrid Grid.Row="0" ItemsSource="{Binding Legs}" SelectedItem="{Binding SelectedLeg, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_Leg}" Binding="{Binding Number}" Width="70"/>
                    <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_From}" Binding="{Binding From}" Width="90"/>
                    <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_To}" Binding="{Binding To}" Width="90"/>
                    <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_Length}" Binding="{Binding LengthMeters, StringFormat='{}{0:F1} m'}" Width="120"/>
                    <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_Turns}" Binding="{Binding DirectionChanges}" Width="80"/>
                    <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_TotalTurn}" Binding="{Binding TotalDirectionChangeDegrees, StringFormat='{}{0:F0}°'}" Width="120"/>
                    <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_MaxTurn}" Binding="{Binding MaximumDirectionChangeDegrees, StringFormat='{}{0:F0}°'}" Width="120"/>
                    <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_Candidates}" Binding="{Binding CandidateSummary}" Width="260"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="1" ColumnDefinitions="*,220" Margin="0,6,0,0">
            <DataGrid Grid.Column="0" ItemsSource="{Binding SelectedLeg.Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_Name}" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_Length}" Binding="{Binding LengthMeters, StringFormat='{}{0:F1} m'}" Width="100"/>
                <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_LengthDelta}" Binding="{Binding LengthDeltaMeters, StringFormat='{}{0:+0.0;-0.0;0} m'}" Width="100"/>
                <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_TurnDelta}" Binding="{Binding DirectionChangeDelta}" Width="90"/>
                <DataGridTextColumn Header="{resx:Localize RouteChoiceAnalysisDialog_Notes}" Binding="{Binding Notes}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4">
              <TextBlock Text="{resx:Localize RouteChoiceAnalysisDialog_CandidateDetails}" FontWeight="Bold"/>
              <TextBox PlaceholderText="{resx:Localize RouteChoiceAnalysisDialog_Name}" Text="{Binding SelectedCandidate.EditableName, Mode=TwoWay}"/>
              <TextBox PlaceholderText="{resx:Localize RouteChoiceAnalysisDialog_Source}" Text="{Binding SelectedCandidate.EditableSource, Mode=TwoWay}"/>
              <TextBox PlaceholderText="{resx:Localize RouteChoiceAnalysisDialog_Notes}" Text="{Binding SelectedCandidate.EditableNotes, Mode=TwoWay}" AcceptsReturn="True" Height="55"/>
              <Button Content="{resx:Localize RouteChoiceAnalysisDialog_SaveCandidate}" Command="{Binding SaveCandidateCommand}"/>
            </StackPanel>
            </Grid>
          </Grid>
        </Border>
    </DockPanel>
</Window>
