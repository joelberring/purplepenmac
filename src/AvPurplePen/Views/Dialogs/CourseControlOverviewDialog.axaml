<!--
    CourseControlOverviewDialog.axaml
    A concise overview of courses and controls in the current event.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        x:Class="AvPurplePen.Views.CourseControlOverviewDialog"
        x:DataType="vm:CourseControlOverviewDialogViewModel"
        Title="{resx:Localize CourseControlOverviewDialog_Title}"
        Width="880" Height="600" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" CanMinimize="False" CanMaximize="False">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{resx:Localize CourseControlOverviewDialog_ShowSelectedControl}" Width="185"
                    IsVisible="{Binding IsControlsTab}" Click="ShowSelectedControlButton_Click"/>
            <Button Content="{resx:Localize CourseControlOverviewDialog_SaveEdits}" Width="120"
                    IsVisible="{Binding IsControlsTab}" Click="SaveEditsButton_Click"/>
            <Button Content="{resx:Localize CourseControlOverviewDialog_ShowSelectedCourse}" Width="170"
                    IsVisible="{Binding IsCoursesTab}" Click="ShowSelectedCourseButton_Click"/>
            <Button Content="{resx:Localize CancelButton}" Width="100" Click="CloseButton_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{resx:Localize CourseControlOverviewDialog_InvalidLoad}"
                   IsVisible="{Binding HasLoadValidationError}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="{resx:Localize CourseControlOverviewDialog_Courses}">
                <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                    <TextBlock Text="{resx:Localize CourseControlOverviewDialog_CoursesIntro}" TextWrapping="Wrap"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBox PlaceholderText="{resx:Localize CourseControlOverviewDialog_SearchCourses}"
                                 Text="{Binding CourseSearchText, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="{resx:Localize CourseControlOverviewDialog_SortLoad}" Command="{Binding SortCoursesByLoadCommand}"/>
                        <Button Grid.Column="2" Content="{resx:Localize CourseControlOverviewDialog_SortName}" Command="{Binding SortCoursesByNameCommand}"/>
                        <Button Grid.Column="3" Content="{resx:Localize CourseControlOverviewDialog_ShowAll}"
                                Command="{Binding ShowAllCoursesCommand}"/>
                    </Grid>
                    <Grid Grid.Row="2" RowDefinitions="Auto,*" ColumnDefinitions="3*,Auto,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Text="{resx:Localize CourseControlOverviewDialog_Name}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{resx:Localize CourseControlOverviewDialog_Controls}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="{resx:Localize CourseControlOverviewDialog_Length}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="{resx:Localize CourseControlOverviewDialog_Climb}" FontWeight="Bold"/>
                        <ListBox Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{Binding VisibleCourses}"
                                 SelectedItem="{Binding SelectedCourse, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CourseOverviewItem">
                                    <Grid ColumnDefinitions="3*,Auto,Auto,Auto" ColumnSpacing="12" Margin="4,3">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ControlCount}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Length}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Climb}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding Warning}" Foreground="DarkOrange" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,160,Auto,160" ColumnSpacing="8" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="{resx:Localize CourseControlOverviewDialog_Class}"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedCourse.ClassName}" IsReadOnly="True"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{resx:Localize CourseControlOverviewDialog_Load}"/>
                        <TextBox Grid.Column="3" Text="{Binding SelectedCourse.LoadText}" IsReadOnly="True"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{resx:Localize CourseControlOverviewDialog_Controls}">
                <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                    <TextBlock Text="{resx:Localize CourseControlOverviewDialog_ControlsIntro}" TextWrapping="Wrap"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox PlaceholderText="{resx:Localize CourseControlOverviewDialog_SearchControls}"
                                 Text="{Binding ControlSearchText, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="{resx:Localize CourseControlOverviewDialog_SortLoad}" Command="{Binding SortControlsByLoadCommand}"/>
                        <Button Grid.Column="2" Content="{resx:Localize CourseControlOverviewDialog_SortCode}" Command="{Binding SortControlsByCodeCommand}"/>
                    </Grid>
                    <Grid Grid.Row="2" RowDefinitions="Auto,*" ColumnDefinitions="2*,4*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Text="{resx:Localize CourseControlOverviewDialog_Control}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{resx:Localize CourseControlOverviewDialog_Courses}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="{resx:Localize LegConnectionsDialog_Incoming}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="{resx:Localize LegConnectionsDialog_Outgoing}" FontWeight="Bold"/>
                        <ListBox Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{Binding VisibleControls}"
                                 SelectedItem="{Binding SelectedControl, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ControlOverviewItem">
                                    <Grid ColumnDefinitions="2*,4*,Auto,Auto" ColumnSpacing="12" Margin="4,3">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Courses}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Incoming}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Outgoing}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Warning}" Grid.ColumnSpan="4" Foreground="DarkOrange" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,160" ColumnSpacing="8" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="{resx:Localize CourseControlOverviewDialog_Code}"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedControl.Code, Mode=TwoWay}"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{resx:Localize CourseControlOverviewDialog_Compare}">
                <StackPanel Margin="10" Spacing="10">
                    <TextBlock Text="{resx:Localize CourseControlOverviewDialog_CompareIntro}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                        <TextBlock Text="{resx:Localize CourseControlOverviewDialog_FirstCourse}"/>
                        <TextBlock Grid.Column="1" Text="{resx:Localize CourseControlOverviewDialog_SecondCourse}"/>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding Courses}" SelectedItem="{Binding ComparisonCourse, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CourseOverviewItem"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Courses}" SelectedItem="{Binding ComparisonWithCourse, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CourseOverviewItem"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Content="{resx:Localize CourseControlOverviewDialog_ShowComparison}" Click="CompareCoursesButton_Click"/>
                    </Grid>
                    <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
