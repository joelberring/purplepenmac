<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        x:Class="AvPurplePen.Views.LegConnectionsDialog"
        x:DataType="vm:LegConnectionsDialogViewModel"
        Title="{resx:Localize LegConnectionsDialog_Title}"
        Width="620" Height="500" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" CanMinimize="False" CanMaximize="False">
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" Content="{resx:Localize CancelButton}" Width="100" HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseButton_Click"/>
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <TextBlock Text="{Binding ControlName}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Text="{resx:Localize LegConnectionsDialog_Intro}" TextWrapping="Wrap"/>
            <Grid Grid.Row="2" ColumnDefinitions="*,12,*" RowDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="{resx:Localize LegConnectionsDialog_Incoming}" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="{resx:Localize LegConnectionsDialog_Outgoing}" FontWeight="Bold"/>
                <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Incoming}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegConnectionItem">
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding CourseName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OtherControlName}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Outgoing}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegConnectionItem">
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding CourseName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding OtherControlName}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
